# Anthropic API key — required for the chatbot to answer questions
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model
# MODEL=claude-opus-5

# Optional: directory containing the three datasets
# (TRF_DANGEROUS_JOIN_V3.csv, TRF_DRIVER_CID_CASES.csv, TRF_DRIVER_MOVEMENTS_V2.csv)
# defaults to the repo root
# DATA_DIR=/path/to/data
